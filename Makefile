# Project info 
PRJ = vga
TOP = top

# Project target performances
FPGA_MODE 	= speed		# One of : lowpower, economy, speed
TIMING 		= worst	    # One of : best, typical, worst

# Tool alias (Change if tool not in path)
veryl 			= veryl
verilator 		= verilator
surfer 			= surfer
yosys 			= yosys
nextpnr 		= nextpnr-himbaechel
gmpack 			= gmpack
openFPGALoader 	= openFPGALoader

# Tool flags
yosys_flg 	= -luttree -nomx8 														# Mandatory: luttree, nomx8; Optional: noflatten, nobram, noaddf, nomult, nomx4, noiopad, noclkbuf
nextpnr_flg = --device=CCGM1A1 -o fpga_mode=$(FPGA_MODE) -o time_mode=$(TIMING)		# Possible to use --gui here

# Source directory
SRC = src
BLD = .build
SIM = simulation
CST = constraint
TRT = target
SNT = synthesis
IMP = implementation

# Get the sv files generated by Veryl
verilog_src = $(shell find ./$(TRT)/ -type f \( -iname \*.v -o -iname \*.sv \))

# Primitives
yosys_datdir = $(shell yosys-config --datdir)
CC_SIM = $(yosys_datdir)/gatemate/cells_sim.v
CC_BB = $(yosys_datdir)/gatemate/cells_bb.v

gen_sv:
	$(veryl) build

synth:
	@test -d $(SNT) || mkdir $(SNT)
	$(yosys) -v 0 -l $(SNT)/synth.log -m slang -p 'read_slang -v $(CC_SIM) -v $(CC_BB) $(verilog_src); synth_gatemate -top $(PRJ)_$(TOP) $(yosys_flg); write_json $(SNT)/synth.json; write_verilog $(SNT)/netlist.v'

impl:
	@test -d $(IMP) || mkdir $(IMP)
	$(nextpnr) -q  -l $(IMP)/impl.log --json $(SNT)/synth.json -o ccf=$(CST)/GateMateA1-EVB.ccf -o out=$(IMP)/impl.txt $(nextpnr_flg)
	$(gmpack) $(IMP)/impl.txt $(IMP)/bitstream.bit 

flash:
	openFPGALoader -b olimex_gatemateevb $(IMP)/bitstream.bit

flash_persistent:
	openFPGALoader -f -b olimex_gatemateevb $(IMP)/bitstream.bit

verilator: gen_sv
	$(verilator) --cc --top-module tb_top -f $(PRJ).f $(SIM)/tb_top.sv --exe $(SIM)/tb_main.cpp -Wno-WIDTHEXPAND -O3 -Mdir $(SIM)/obj_dir -o tb_top -LDFLAGS "$(shell pkg-config sdl3 --libs)"
	make -C ./$(SIM)/obj_dir/ -f Vtb_top.mk 
	./$(SIM)/obj_dir/tb_top

verilator_prof: gen_sv
	$(verilator) --prof-cfuncs --cc --top-module tb_top -f $(PRJ).f $(SIM)/tb_top.sv --exe $(SIM)/tb_main.cpp -Wno-WIDTHEXPAND -O3 -Mdir $(SIM)/obj_dir -o tb_top -LDFLAGS "$(shell pkg-config sdl3 --libs)"
	make -C ./$(SIM)/obj_dir/ -f Vtb_top.mk 
	./$(SIM)/obj_dir/tb_top
	gprof ./$(SIM)/obj_dir/tb_top gmon.out > gprof.log
	verilator_profcfunc gprof.log > profcfunc.log

all: gen_sv synth impl flash

clean:
	$(veryl) clean
	rm -rf $(SNT)
	rm -rf $(IMP)
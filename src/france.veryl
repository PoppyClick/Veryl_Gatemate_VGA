module france #(
    param COLOR_DEPTH: u32 = 4  ,
    param H_PIXELS   : u32 = 640,
    param V_PIXELS   : u32 = 480,
) (
    sx: input  u16               ,
    sy: input  u16               ,
    de: input  logic             ,
    r : output logic<COLOR_DEPTH>,
    g : output logic<COLOR_DEPTH>,
    b : output logic<COLOR_DEPTH>,
) {

    always_comb {
        if (de) {
            if (sx <: H_PIXELS / 3) {
                r = 0;
                g = 0;
                b = 2 ** COLOR_DEPTH - 1;
            } else if (sx <: 2 * H_PIXELS / 3) {
                r = 2 ** COLOR_DEPTH - 1;
                g = 2 ** COLOR_DEPTH - 1;
                b = 2 ** COLOR_DEPTH - 1;
            } else {
                r = 2 ** COLOR_DEPTH - 1;
                g = 0;
                b = 0;
            }
        } else {
            r = 0;
            g = 0;
            b = 0;
        }
    }
}
